# OpenSEO on the Node runtime (experimental): a plain Node server beside
# Postgres, no Workers runtime. See docs/SELF_HOSTING_NODE.md and
# compose.node.yaml. The default image (./Dockerfile) runs the Workers build
# in Miniflare instead.

# --- Build: full install, then the Node build (vite.node.config.ts) ---------
FROM node:22-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile

COPY . .
# The ~7400-module SSR build needs more than Node's ~2 GiB default heap.
RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm exec vite build --config vite.node.config.ts

# --- Runtime: production dependencies, the build, and Postgres migrations --
FROM node:22-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NODE_ENV=production
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY patches ./patches
RUN pnpm install --prod --frozen-lockfile && pnpm store prune

COPY --from=build /app/dist-node ./dist-node
COPY drizzle/pg ./drizzle/pg
COPY scripts/node-server.mjs ./scripts/node-server.mjs

# Blobs (exports, cached responses) and site-audit crawl state live on disk;
# mount /data on a persistent volume.
ENV PORT=3001
ENV BLOB_DIR=/data/blobs
ENV DURABLE_OBJECT_DIR=/data/durable-objects
RUN mkdir -p /data && chown node:node /data
VOLUME ["/data"]
USER node

EXPOSE 3001

# Readiness probe against the unauthenticated setup/health endpoint. The start
# period covers migrations, which run at every start.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/api/health').then(function(r){process.exit(r.ok?0:1)}).catch(function(){process.exit(1)})"

CMD ["node", "scripts/node-server.mjs"]
